# Database Configuration (Replace with your local credentials)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=smarttraffic

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000
SECRET_KEY=replace_with_a_secure_random_key

# C Engine Path
C_ENGINE_PATH=c_engine/bin/traffic_engine.exe
